# Copie locale uniquement : aucune de ces valeurs ne convient à un déploiement.
# APP_ENV obligatoire ; aucun défaut implicite local au démarrage.
APP_ENV=local
# Mode Node ; production doit refuser les fixtures.
NODE_ENV=development
# Nom Docker ; choisir un nom unique pour un autre checkout actif.
COMPOSE_PROJECT_NAME=coverview-local
# Adresse et port de l'API locale.
API_HOST=127.0.0.1
API_PORT=4100
# Logs structurés, sans donnée de connexion.
LOG_LEVEL=info
# Personas fictives ; interdit hors local/development.
FIXTURE_MODE=true
# Aucun fournisseur externe : seulement les services locaux du compose.
EXTERNAL_ADAPTER_MODE=local
# Connexion Postgres factice loopback, jamais exposée aux interfaces.
DATABASE_URL=postgresql://coverview:coverview-local@127.0.0.1:55432/coverview_local
# Service Redis local.
REDIS_URL=redis://127.0.0.1:56379
# Endpoints de santé locaux sans credential client.
MINIO_ENDPOINT=http://127.0.0.1:59000
MAILPIT_URL=http://127.0.0.1:48025
# Origines exactes des interfaces locales.
CORS_ORIGINS=http://127.0.0.1:4101,http://127.0.0.1:4102,http://127.0.0.1:4103
# Borne des vérifications externes en millisecondes.
DEPENDENCY_TIMEOUT_MS=2000
# AuthKit désactivé tant que les credentials ne sont pas injectés dans le processus API.
AUTH_ENABLED=false
# Identifiant public vérifié dans l'environnement WorkOS choisi, exemple factice uniquement.
# WORKOS_CLIENT_ID=client_example
# Émetteur de l'access token AuthKit, distinct de l'issuer de découverte OIDC du client.
# Conserver le défaut API sauf domaine auth personnalisé vérifié.
WORKOS_ISSUER=https://api.workos.com/
# Secret WorkOS serveur, injecté par l'opérateur ; ne pas écrire sa valeur ici ou dans .env.
# WORKOS_API_KEY=placeholder
# Clé aléatoire base64 de 32 octets, injectée au processus serveur uniquement.
# AUTH_SESSION_SECRET=placeholder
# Origine API : callback exact /auth/callback ; HTTPS obligatoire hors loopback local.
AUTH_API_ORIGIN=http://127.0.0.1:4100
# Destinations exactes après authentification ; page /account dans chaque surface.
AUTH_WALLET_ORIGIN=http://127.0.0.1:4101
AUTH_ADMIN_ORIGIN=http://127.0.0.1:4102
AUTH_WWW_ORIGIN=http://127.0.0.1:4103
# Expiration absolue technique locale (secondes), jamais au-delà de la session WorkOS.
AUTH_SESSION_TTL_SECONDS=28800
# Timeout d'un appel WorkOS, sans retry automatique caché.
WORKOS_TIMEOUT_MS=3000
# Option frontend facultative VITE_API_URL : URL publique absolue de l'API.
# Absente : loopback en développement, même origine dans le build déployé.
# Aucun autre préfixe n'est exposé par Vite. Ne jamais y placer de credential.
# VITE_WEBSITE_URL : origine publique du site pour les liens depuis Wallet.
# PUBLIC_API_URL : origine publique de l'API dans la page compte Astro.
# PUBLIC_WALLET_URL : origine publique de Wallet pour les liens depuis www.
# Ces URL de build doivent correspondre aux origines AUTH_* et CORS autorisées.
