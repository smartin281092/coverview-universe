{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "preview.config.mjs",
        "scripts/verify-brand.mjs",
        "scripts/verify-planning.mjs",
        "scripts/verify-health-live.mjs",
        "scripts/health-terrain-tiles.mjs",
        ".claude/hooks/guard-bash.mjs"
      ],
      "project": [
        "*.mjs",
        "scripts/**/*.mjs",
        "evals/**/*.mjs",
        "tests/**/*.mjs",
        ".claude/hooks/*.mjs"
      ]
    },
    "apps/api": {
      "entry": [
        "src/**/*.test.ts",
        "src/modules/health-insurance/health.import.ts",
        "src/modules/health-insurance/health.foreign.import.ts",
        "src/modules/health-insurance/recommendation.import.ts",
        "src/modules/document-intelligence/document.pdf-annotations-worker.ts"
      ],
      "project": ["src/**/*.ts", "*.ts", "*.mjs"]
    },
    "apps/client": {
      "ignoreDependencies": ["@react-three/fiber", "three", "@types/three"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/admin": {
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/partners": {
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/www": {
      "ignoreDependencies": ["gsap", "@react-three/fiber", "three", "@types/three"],
      "project": ["src/**/*.{ts,tsx,astro,mdx,css}"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "packages/contracts": {
      "project": ["src/**/*.ts"]
    },
    "packages/api-client": {
      "project": ["src/**/*.ts"]
    }
  }
}
