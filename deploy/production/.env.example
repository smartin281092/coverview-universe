# Copié en /opt/coverview-astra/.env sur le serveur, mode 0600. Valeurs factices ici.
# Mot de passe PostgreSQL : généré sur le serveur (openssl rand -hex 32), jamais affiché ni versionné.
POSTGRES_PASSWORD=change-me-on-the-server
# Commit déployé : étiquette des images ghcr.io/smartin281092/coverview-astra-api, -www et -apps.
RELEASE=0000000
# Comptes : true seulement quand les secrets WorkOS et de session sont dans api.env.
AUTH_ENABLED=false
# Wallet, Partner et Admin : « apps » les sert, absent les laisse redirigés vers l'accueil.
# « documents » ajoute MinIO et ClamAV.
# COMPOSE_PROFILES=apps,documents
# Documents : true seulement avec le profil « documents » et leurs secrets dans api.env.
# DOCUMENTS_ENABLED=false
# Expéditeur des emails, sur le sous-domaine vérifié chez Resend.
# MAIL_FROM=CoverView <notifications@mail.coverview.ch>
