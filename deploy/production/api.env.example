# Copié en /opt/coverview-astra/api.env sur le serveur, mode 0600, lu par l'API seule.
# Valeurs factices ici : chaque clé est saisie sur le serveur sans être affichée.
# WorkOS, environnement Production (projet coverview).
# WORKOS_API_KEY=sk_example
# WORKOS_CLIENT_ID=client_example
# Session : 32 octets aléatoires en base64, générés sur le serveur (openssl rand -base64 32).
# AUTH_SESSION_SECRET=example-generated-on-the-server
# Resend, clé limitée à l'envoi (Sending access) sur le domaine mail.coverview.ch.
# RESEND_API_KEY=re_example
