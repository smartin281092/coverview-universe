# Wallet, Partner et Admin derrière le Traefik du serveur, qui porte TLS et HSTS. Chaque adresse
# sert sa propre application ; toute autre adresse retourne à l'accueil.
{
	admin off
	auto_https off
}

:8080 {
	map {host} {app} {
		{$WALLET_HOST:wallet.coverview.ch} wallet
		{$PARTNER_HOST:partner.coverview.ch} partner
		{$ADMIN_HOST:admin.coverview.ch} admin
		default none
	}
	@unknown expression {app} == "none"
	redir @unknown {$SITE_ORIGIN:https://coverview.ch}/ 302

	root * /srv/{app}
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# Fichiers versionnés par Vite ; la page d'entrée est toujours relue.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@entry not path /assets/*
	header @entry Cache-Control "no-cache"
	# Applications à routage côté client : toute adresse inconnue rend la page d'entrée.
	try_files {path} /index.html
	file_server
}
