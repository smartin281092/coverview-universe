# Site public CoverView derrière le Traefik du serveur, qui porte TLS et HSTS.
{
	admin off
	auto_https off
}

:8080 {
	# Surfaces encore fermées (Wallet, Partner, Admin, ancienne préproduction) : retour à l'accueil.
	@closed not host {$SITE_HOST:coverview.ch}
	redir @closed {$SITE_ORIGIN:https://coverview.ch}/ 302

	# En attendant le site complet, l'accueil donne sur le comparateur maladie (temporaire, 302).
	@home path /
	redir @home /comparateur-assurance-maladie-2027 302

	root * /srv
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# La recherche de localité peut utiliser la position, sur ce site uniquement.
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		-Server
	}
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Relief et arbres de la carte 3D : fichiers versionnés dans le chemin (/terrain/v1,
	# /terrain/lowpoly-v1, /map/trees-v1.json), jamais modifiés.
	@terrain path /terrain/* /map/*
	header @terrain Cache-Control "public, max-age=31536000, immutable"
	try_files {path} {path}/index.html {path}.html
	file_server
	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			rewrite * /404.html
			file_server
		}
	}
}
