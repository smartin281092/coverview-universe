---
interface Props { kind: number; }
const { kind } = Astro.props;
---
<div class:list={['resource-visual', `resource-visual--${kind}`]} aria-hidden="true">
  {kind === 0 && <svg viewBox="0 0 280 160" fill="none"><path d="M84 37v88M140 37v88M196 37v88M66 62h148M66 90h148M66 118h148" stroke="currentColor" stroke-width="1"/><circle cx="112" cy="76" r="5" fill="currentColor"/><circle cx="168" cy="104" r="5" fill="currentColor"/></svg>}
  {kind === 1 && <svg viewBox="0 0 280 160" fill="none"><circle cx="140" cy="80" r="44" stroke="currentColor" stroke-width="1"/><path d="m118 81 15 15 29-33" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M88 26h-6v12M192 134h6v-12" stroke="currentColor" stroke-width="1"/></svg>}
  {kind === 2 && <span class="resource-letter">Aa<span>.</span></span>}
  {kind === 3 && <svg viewBox="0 0 280 160" fill="none"><path d="M92 124V35h72l24 24v65H92Z" stroke="currentColor"/><path d="M164 35v24h24M112 78h56M112 91h56M112 104h34" stroke="currentColor"/><circle cx="190" cy="115" r="18" fill="var(--color-paper)" stroke="currentColor"/><path d="M190 106v18M181 115h18" stroke="currentColor"/></svg>}
</div>
