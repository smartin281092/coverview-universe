---
import { hyperionLogo } from './hyperion-logo';
// Decorative by default: the product name is always written next to it.
interface Props { class?: string; size?: number; label?: string; }
const { class: className, size = 54, label } = Astro.props;
---
<svg class:list={['hp-logo-mark', className]} viewBox={hyperionLogo.viewBox} width={size} height={size} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false"><path d={hyperionLogo.d} fill="currentColor"/></svg>
