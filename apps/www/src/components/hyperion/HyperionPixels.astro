---
// A field of small twinkling pixels over a dark card (user request, 4 November 2026: the living
// touch of the BM Partners dark surfaces). Deterministic positions, so the HTML never changes.
interface Props { seed?: number; count?: number; }
const { seed = 1, count = 24 } = Astro.props;
let state = (seed * 2654435761) >>> 0;
const random = () => {
  state = (state + 0x6d2b79f5) >>> 0;
  let t = state;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const colors = ['#ffffff', '#a5f3fc', '#c7d2fe', '#e0e7ff', '#93c5fd'];
const pixels = Array.from({ length: count }, () => ({
  x: (random() * 96 + 2).toFixed(1),
  y: (random() * 90 + 5).toFixed(1),
  size: random() < 0.25 ? 4 : random() < 0.6 ? 3 : 2,
  delay: (random() * 6).toFixed(2),
  duration: (3 + random() * 4).toFixed(2),
  color: colors[Math.floor(random() * colors.length)],
}));
---
<span class="hp-pixels" aria-hidden="true">{pixels.map((p) => <i style={`left:${p.x}%;top:${p.y}%;width:${p.size}px;height:${p.size}px;animation-delay:${p.delay}s;animation-duration:${p.duration}s;background:${p.color}`}></i>)}</span>
