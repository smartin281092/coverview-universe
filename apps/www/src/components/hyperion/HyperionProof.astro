---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TitleText from '../landing/TitleText.astro';
import Arrow from '../landing/Arrow.astro';
import HyperionChevrons from './HyperionChevrons.astro';
import { performanceCopy } from '../../content/fr/performance';
import { hyperionCopy } from '../../content/fr/hyperion';
import { formatNumber } from '../landing/calculations';
import history from '../../assets/performance/allocation-history.png';
import december from '../../assets/performance/performance-december.png';
import march from '../../assets/performance/performance-march.png';
import may from '../../assets/performance/performance-since-may.png';
import ytd from '../../assets/performance/performance-ytd.png';
import year from '../../assets/performance/performance-one-year.png';
import since2018 from '../../assets/performance/performance-since-2018.png';
import '../../styles/landing-proof.css';
// The seven captures already on the home page (22 September 2026), with their periods and limits.
const images = {
  'performance-ytd': ytd, 'performance-march': march, 'performance-december': december,
  'performance-since-may': may, 'performance-one-year': year, 'performance-since-2018': since2018,
} satisfies Record<(typeof performanceCopy.captures)[number]['file'], ImageMetadata>;
const c = hyperionCopy.proof;
const featured = performanceCopy.captures.slice(0, 3);
---
<section class="lp-section performance-section hp-proof" id="resultats" aria-labelledby="hp-proof-title">
  <div class="lp-container">
    <div class="lp-section-head" data-reveal>
      <div><p class="lp-eyebrow">{c.eyebrow}</p><h2 id="hp-proof-title"><TitleText text={c.title}/></h2></div>
      <p class="lp-description">{c.description}</p>
    </div>
    <div class="performance-grid" data-scene>
      {featured.map((capture, i) => <article class:list={['performance-card', `performance-card-${i}`, { 'hp-proof-dark hp-card-dark': i % 2 === 0 }]} data-reveal>
        {i % 2 === 0 && <canvas class="hp-pixels" data-pixel-field aria-hidden="true"></canvas>}
        <div class="performance-card-copy">
          <p class="performance-card-label">{capture.title}</p>
          <div class="hp-proof-value"><HyperionChevrons class="is-small" /><p class="performance-value"><span aria-hidden="true">+</span><span>{formatNumber(capture.value, 2)}</span><span class="performance-unit">%</span></p></div>
          <p class="performance-period">{capture.period}</p>
          <p class="performance-metric">{capture.metric}</p>
        </div>
        <div class={`performance-chart-preview performance-chart-${capture.id}`} aria-hidden="true">
          <Image src={images[capture.file]} width={720} format="webp" quality={90} alt="" loading="lazy"/>
          <span class="performance-chart-glint"></span>
        </div>
      </article>)}
    </div>
    <div class="performance-bottom">
      <button type="button" class="lp-text-link" data-open-dialog="hyperion-proof">{c.all}<Arrow/></button>
      <p>{c.note}</p>
    </div>
  </div>
</section>
<dialog class="lp-dialog performance-dialog" id="hyperion-proof" aria-labelledby="hp-proof-dialog-title">
  <div class="dialog-top"><p class="lp-eyebrow">{c.eyebrow}</p><button type="button" class="dialog-close" data-close-dialog aria-label={c.close}>×</button></div>
  <h2 id="hp-proof-dialog-title"><TitleText text={c.dialogTitle}/></h2>
  <p>{performanceCopy.dialogIntro}</p>
  <div class="performance-reading"><h3>{performanceCopy.limits}</h3><p>{performanceCopy.attribution}</p><p>{performanceCopy.twrr}</p><p>{performanceCopy.note}</p></div>
  <div class="performance-source-grid">
    {performanceCopy.captures.map(capture => <figure>
      <figcaption><h3>+{formatNumber(capture.value, 2)} %</h3><p>{capture.period}</p><small>{capture.metric}</small></figcaption>
      <Image src={images[capture.file]} width={Math.min(images[capture.file].width, 1100)} format="webp" quality={95} alt={capture.alt} loading="lazy"/>
      <p>{capture.note}</p>
    </figure>)}
  </div>
  <figure class="performance-history"><figcaption><h3><TitleText text={performanceCopy.historyTitle}/></h3><p>{performanceCopy.historyNote}</p></figcaption><Image src={history} width={1200} format="webp" quality={95} alt={performanceCopy.history.alt} loading="lazy"/></figure>
</dialog>
