---
import { hyperionCopy } from '../../content/fr/hyperion';
import { HYPERION } from './hyperion-model';
import { hyperionLogo } from './hyperion-logo';
interface Props { id?: string; class?: string; }
const { id = 'hyperion-box', class: className } = Astro.props;
const c = hyperionCopy.gallery;
// Candlesticks in the background: a rising series, drawn behind the box.
const candles = [
  { x: 574, open: 452, close: 430, high: 424, low: 462 },
  { x: 596, open: 430, close: 441, high: 422, low: 449 },
  { x: 618, open: 441, close: 404, high: 396, low: 448 },
  { x: 640, open: 404, close: 372, high: 362, low: 412 },
  { x: 662, open: 372, close: 386, high: 364, low: 395 },
  { x: 684, open: 386, close: 338, high: 326, low: 392 },
  { x: 706, open: 338, close: 312, high: 300, low: 348 },
  { x: 728, open: 312, close: 324, high: 304, low: 334 },
  { x: 750, open: 324, close: 268, high: 256, low: 332 },
];
---
<svg class:list={['hp-illustration', className]} viewBox="0 0 768 768" role="img" aria-label={c.illustrationAlt}>
  <defs>
    <linearGradient id={`${id}-front`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2b347f"/><stop offset=".55" stop-color="#181f5c"/><stop offset="1" stop-color="#0d1240"/></linearGradient>
    <linearGradient id={`${id}-spine`} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#070a27"/><stop offset="1" stop-color="#141a4c"/></linearGradient>
    <linearGradient id={`${id}-top`} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#3b45a3"/><stop offset="1" stop-color="#5563c4"/></linearGradient>
    <linearGradient id={`${id}-facet`} x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity=".02"/><stop offset=".5" stop-color="#fff" stop-opacity=".17"/><stop offset="1" stop-color="#fff" stop-opacity=".04"/></linearGradient>
    <linearGradient id={`${id}-gold`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f7dc92"/><stop offset="1" stop-color="#c7962c"/></linearGradient>
    <linearGradient id={`${id}-gold-side`} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#b07f1f"/><stop offset=".5" stop-color="#e0b64a"/><stop offset="1" stop-color="#a97718"/></linearGradient>
    <linearGradient id={`${id}-note`} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#eef2f6"/><stop offset="1" stop-color="#d7dfe8"/></linearGradient>
    <linearGradient id={`${id}-note-edge`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#c3cdd8"/><stop offset="1" stop-color="#aab6c4"/></linearGradient>
    <filter id={`${id}-shadow`} x="-40%" y="-120%" width="180%" height="340%"><feGaussianBlur stdDeviation="14"/></filter>
    <filter id={`${id}-soft`} x="-40%" y="-120%" width="180%" height="340%"><feGaussianBlur stdDeviation="5"/></filter>
    <clipPath id={`${id}-face`}><polygon points="236,112 556,138 556,632 236,648"/></clipPath>
  </defs>

  <g class="hp-illu-candles" aria-hidden="true">
    {candles.map((candle) => {
      const up = candle.close < candle.open;
      const top = Math.min(candle.open, candle.close), height = Math.max(6, Math.abs(candle.open - candle.close));
      return <g>
        <line x1={candle.x} x2={candle.x} y1={candle.high} y2={candle.low} stroke={up ? '#6f78c9' : '#c4a1a8'} stroke-width="1.6" opacity=".55"/>
        <rect x={candle.x - 6} y={top} width="12" height={height} rx="1.5" fill={up ? '#8a92d8' : '#d9b9bf'} opacity=".55"/>
      </g>;
    })}
    <path d="M566,470 H760" stroke="#c9cce0" stroke-width="1" stroke-dasharray="2 5"/>
  </g>

  <ellipse cx="392" cy="666" rx="236" ry="24" fill="#1a1f4a" opacity=".17" filter={`url(#${id}-shadow)`}/>
  <ellipse cx="396" cy="652" rx="190" ry="10" fill="#0c1038" opacity=".22" filter={`url(#${id}-soft)`}/>

  <polygon points="200,96 236,112 236,648 200,632" fill={`url(#${id}-spine)`}/>
  <polygon points="200,96 520,122 556,138 236,112" fill={`url(#${id}-top)`}/>
  <polygon points="236,112 556,138 556,632 236,648" fill={`url(#${id}-front)`}/>
  <g clip-path={`url(#${id}-face)`} aria-hidden="true">
    <path d="M236,588 C340,470 400,330 556,150 L556,330 C470,400 380,520 318,660 Z" fill={`url(#${id}-facet)`}/>
    <path d="M236,112 C320,236 456,318 556,300 L556,138 Z" fill="#000" opacity=".13"/>
    <path d="M236,648 C320,540 430,492 556,520 L556,632 Z" fill="#fff" opacity=".055"/>
    <path d="M236,112 L556,138" stroke="#fff" stroke-opacity=".28" stroke-width="1.2"/>
  </g>
  <polygon points="236,604 556,588 556,594 236,610" fill={`url(#${id}-gold)`} opacity=".92"/>
  <polygon points="200,92 236,108 236,112 200,96" fill="#fff" opacity=".18"/>

  <g transform="skewY(4.65)" font-family="var(--cv-font-sans), sans-serif" fill="#fff">
    <g transform="translate(316 190) scale(0.1528)"><path d={hyperionLogo.d} fill="#fff"/></g>
    <text x="272" y="310" font-size="60" font-weight="500" letter-spacing="-2.4">{HYPERION.name}</text>
    <text x="274" y="358" font-size="30" font-weight="500" letter-spacing="-0.6" fill={`url(#${id}-gold)`}>{c.box.line1}</text>
    <text x="274" y="396" font-size="15" letter-spacing=".2" fill="#fff" opacity=".74">{c.box.line2}</text>
    <text x="274" y="552" font-size="12" letter-spacing="1.4" fill="#fff" opacity=".55">COVERVIEW · {HYPERION.company.toUpperCase()}</text>
  </g>
  <text transform="translate(226 602) rotate(-90) skewX(-24)" font-family="var(--cv-font-sans), sans-serif" font-size="17" letter-spacing="1.8" fill="#fff" opacity=".78">{c.box.spine.toUpperCase()}</text>

  <g aria-hidden="true">
    <ellipse cx="632" cy="648" rx="112" ry="12" fill="#1a1f4a" opacity=".16" filter={`url(#${id}-soft)`}/>
    {[0, 1, 2, 3].map((i) => <g transform={`translate(${i * 2} ${-i * 9})`}>
      <polygon points="536,600 706,590 712,632 542,642" fill={`url(#${id}-note-edge)`}/>
      <polygon points="536,598 706,588 712,626 542,636" fill={`url(#${id}-note)`} stroke="#b9c4d0" stroke-width=".8"/>
      <polygon points="604,594 650,591 654,624 608,627" fill="#8ea1b8" opacity=".55"/>
      <ellipse cx="628" cy="610" rx="9" ry="7" fill="#fff" opacity=".7"/>
      <line x1="548" y1="608" x2="590" y2="606" stroke="#9fb0c3" stroke-width="1.2"/>
      <line x1="548" y1="616" x2="584" y2="614" stroke="#9fb0c3" stroke-width="1.2"/>
      <line x1="668" y1="604" x2="700" y2="602" stroke="#9fb0c3" stroke-width="1.2"/>
    </g>)}
    <polygon points="612,560 648,558 654,618 618,620" fill={`url(#${id}-gold)`} opacity=".95"/>
    <polygon points="612,560 648,558 648,562 612,564" fill="#fff" opacity=".35"/>
  </g>

  <g aria-hidden="true">
    <ellipse cx="712" cy="662" rx="40" ry="8" fill="#1a1f4a" opacity=".18" filter={`url(#${id}-soft)`}/>
    {[0, 1, 2].map((i) => <g transform={`translate(0 ${-i * 9})`}>
      <path d="M680,648 a30 10 0 0 0 60 0 v-6 a30 10 0 0 1 -60 0 z" fill={`url(#${id}-gold-side)`}/>
      <ellipse cx="710" cy="642" rx="30" ry="10" fill={`url(#${id}-gold)`}/>
      <ellipse cx="710" cy="642" rx="22" ry="7" fill="none" stroke="#fff" stroke-opacity=".45" stroke-width="1"/>
    </g>)}
    <g transform="translate(748 612) rotate(-62)">
      <ellipse cx="0" cy="0" rx="30" ry="10" fill={`url(#${id}-gold-side)`}/>
      <ellipse cx="0" cy="-4" rx="30" ry="10" fill={`url(#${id}-gold)`}/>
      <ellipse cx="0" cy="-4" rx="22" ry="7" fill="none" stroke="#fff" stroke-opacity=".45" stroke-width="1"/>
    </g>
  </g>
</svg>
