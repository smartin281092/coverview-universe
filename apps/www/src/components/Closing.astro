---
import { Container, Section, SectionHeading, ButtonLink, TextLink } from '@coverview/ui';
import { marketing } from '../content/fr/marketing';
const copy = marketing.closing;
---
<Section className="closing-section"><Container>
  <SectionHeading eyebrow={copy.eyebrow} title={copy.title} description={copy.description} align="center" />
  <div class="closing-actions"><ButtonLink href={copy.primary.href} size="lg" className="h-11 px-5 text-sm">{copy.primary.label}</ButtonLink><TextLink href={copy.secondary.href}>{copy.secondary.label}</TextLink></div>
</Container></Section>
