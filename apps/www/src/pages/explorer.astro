---
import Layout from '../layouts/Layout.astro';
import { acquisition as copy } from '../content/fr/acquisition';
import { explorerGroups } from '../content/explorer';
const page = copy.explorer;
---
<Layout title={page.title} description={page.description}>
  <section class="content-page explorer-page">
    <div class="page-intro"><p class="eyebrow">{copy.explore}</p><h1>{page.heading}</h1><p>{page.introduction}</p></div>
    <nav class="explorer-categories" aria-label={page.categories}>
      {explorerGroups.map((group, index) => <a href={`/explorer/${group.slug}`} class="explorer-category">
        <span class="category-number" aria-hidden="true">{new Intl.NumberFormat('fr-CH', { minimumIntegerDigits: 2 }).format(index + 1)}</span>
        <div><h2>{group.label}</h2><p>{group.summary}</p><span class="category-status">{group.status}</span></div>
        <span class="category-arrow" aria-hidden="true">↗</span>
      </a>)}
    </nav>
  </section>
</Layout>
