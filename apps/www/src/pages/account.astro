---
import Layout from "../layouts/Layout.astro";
import { SectionHeading, TextLink } from "@coverview/ui";
import { content } from "../content/fr/interface";
import { marketing } from "../content/fr/marketing";
import icon from "../../../../assets/icon-coverview.svg?url";
const walletUrl = import.meta.env.PUBLIC_WALLET_URL ?? (import.meta.env.DEV ? "http://127.0.0.1:4101" : undefined);
---
<Layout title={content.account.title} description={content.account.description}>
  <section class="account-page">
    <div class="account-welcome">
      <SectionHeading level={1} eyebrow={marketing.account.eyebrow} title={marketing.account.title} description={marketing.account.description} />
      <TextLink href={marketing.account.publicAction.href}>{marketing.account.publicAction.label}</TextLink>
    </div>
    <div id="account-status" class="account-content" aria-busy="true">
      <img src={icon} alt="" width="80" height="73" class="account-symbol" />
      <h2>{content.account.panelTitle}</h2>
      <p id="account-message" role="status" aria-live="polite">{content.account.loading}</p>
      <p id="account-error" role="alert" hidden></p>
      <div class="account-entry-actions">
        <a id="account-login" class="cv-button" hidden>{content.account.login}</a>
        <button id="account-retry" type="button" class="cv-button" hidden>{content.account.retry}</button>
        {walletUrl && <TextLink href={new URL("/account", walletUrl).href}>{content.account.wallet}</TextLink>}
      </div>
      <p class="account-privacy">{content.account.privacy}</p>
      <noscript><p>{content.account.noScript}</p></noscript>
    </div>
  </section>
</Layout>
<script>
  import "../account";
</script>
