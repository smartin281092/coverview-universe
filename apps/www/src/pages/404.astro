---
import Layout from '../layouts/Layout.astro';
import { ButtonLink } from '@coverview/ui';
import { content } from '../content/fr/interface';
const copy = content.notFound;
---
<Layout title={copy.title} description={copy.description}>
  <section class="missing-page"><h1>{copy.heading}</h1><p>{copy.body}</p><ButtonLink href="/">{copy.action}</ButtonLink></section>
</Layout>
