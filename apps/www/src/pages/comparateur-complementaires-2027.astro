---
import Layout from '../layouts/Layout.astro';
import SupplementaryComparator from '../components/supplementary/SupplementaryComparator';
import SupplementaryMethod from '../components/supplementary/SupplementaryMethod.astro';
import { supplementaryCopy as copy } from '../content/fr/supplementary';
import '../styles/health-insurance.css';
import '../styles/supplementary.css';
const apiUrl = import.meta.env.PUBLIC_API_URL ?? (import.meta.env.DEV ? 'http://127.0.0.1:4100' : Astro.site?.origin ?? Astro.url.origin);
const url = new URL('/comparateur-complementaires-2027', Astro.site).href;
---
<Layout title={copy.list.title} description={copy.list.description} structuredData={{'@context':'https://schema.org','@type':'WebPage',name:copy.list.heading,description:copy.list.description,url,inLanguage:'fr-CH'}}>
  <div class="sc-page">
    <section class="sc-band sc-hero">
      <div class="sc-shell">
        <nav class="sc-breadcrumb" aria-label={copy.breadcrumb.label}>
          <ol>
            <li><a href="/">{copy.breadcrumb.home}</a></li>
            <li><a href="/explorer/outils">{copy.breadcrumb.comparator}</a></li>
            <li aria-current="page">{copy.breadcrumb.list}</li>
          </ol>
        </nav>
        <h1>{copy.list.heading}</h1>
        <p class="sc-lead">{copy.list.lead}</p>
      </div>
    </section>
    <SupplementaryComparator apiUrl={apiUrl} view="list" client:load />
    <SupplementaryMethod link="comparison" />
  </div>
</Layout>
