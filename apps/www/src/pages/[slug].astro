---
import type { InferGetStaticPropsType } from 'astro';
import Layout from '../layouts/Layout.astro';
import { acquisition as copy, journeys, plannedPages } from '../content/fr/acquisition';
import EditorialPage from '../components/EditorialPage.astro';
import EditorialIndex from '../components/EditorialIndex.astro';
import { editorials, editorialIndexes, readableEditorialPaths } from '../content/editorial';
export function getStaticPaths() {
  return [
    ...[...journeys, ...plannedPages].filter((page) => !readableEditorialPaths.has(page.slug)).map((page) => ({ params: { slug: page.slug }, props: { page, entry: undefined, listing: undefined } })),
    ...editorials.filter((entry) => !entry.data.slug.includes('/') && !['methode', 'sebastien-martin'].includes(entry.data.slug)).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, page: undefined, listing: undefined } })),
    ...editorialIndexes.filter((listing) => !listing.slug.includes('/')).map((listing) => ({ params: { slug: listing.slug }, props: { listing, page: undefined, entry: undefined } })),
  ];
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page, entry, listing } = Astro.props;
---
{entry && <EditorialPage entry={entry} />}
{listing && <EditorialIndex listing={listing} />}
{page && <Layout title={copy.availabilityTitle.replace('{{label}}', page.label)} description={page.description}>
  <section class="reading-page">
    <a href="/overview" class="text-link">← {copy.returnOverview}</a>
    <p class="stage-label">{copy.coming}</p>
    <h1>{'heading' in page ? page.heading : page.label}</h1>
    <p class="intro">{page.unavailable}</p>
    <section class="reading-card"><h2>{copy.preparation}</h2><p>{'preparation' in page ? page.preparation : page.description}</p><a href="/methode" class="text-link">{copy.home.methodAction}<span aria-hidden="true">→</span></a></section>
    <a href="/explorer" class="text-link">{copy.returnExplore}<span aria-hidden="true">→</span></a>
  </section>
</Layout>}
