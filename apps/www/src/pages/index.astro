---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import dawn from '../../../../assets/dawn-bg.png';
import { acquisition as copy } from '../content/fr/acquisition';
import HomeContent, { frontmatter } from '../content/fr/home.mdx';
import { content } from '../content/fr/interface';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', name: content.brand, url: Astro.site?.href },
    { '@type': 'WebSite', name: content.brand, url: Astro.site?.href, inLanguage: 'fr-CH', description: frontmatter.description },
  ],
};
---
<Layout title={frontmatter.title} description={frontmatter.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">{copy.home.eyebrow}</p>
      <h1>{copy.home.heading}</h1>
      <div class="intro"><HomeContent /></div>
      <div class="hero-actions">
        <a href="/methode" class="primary-link">{copy.home.discover}<span aria-hidden="true">→</span></a>
        <a href="/account" class="secondary-link">{copy.home.account}</a>
      </div>
      <p class="preview-note">{copy.home.note}</p>
    </div>
    <div class="reading-frame">
      <Image src={dawn} alt="" width={700} format="webp" loading="eager" class="reading-background" />
      <section class="reading-preview" aria-labelledby="reading-title">
        <p class="eyebrow">{copy.home.readingLabel}</p>
        <h2 id="reading-title">{copy.home.readingTitle}</h2>
        <ul class="reading-shortcuts">
          {copy.home.readings.map((reading) => <li><a href={reading.href}><span><strong>{reading.label}</strong><small>{reading.description}</small></span><span aria-hidden="true">↗</span></a></li>)}
        </ul>
      </section>
    </div>
  </section>
  <section class="method-strip" aria-labelledby="method-title">
    <div><h2 id="method-title">{copy.home.methodTeaser}</h2><p>{copy.home.methodText}</p></div>
    <a href="/overview" class="text-link">{copy.choose}<span aria-hidden="true">→</span></a>
  </section>
</Layout>
