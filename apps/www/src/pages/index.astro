---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import dawn from '../../../../assets/dawn-bg.png';
import { acquisition as copy } from '../content/fr/acquisition';
import HomeContent, { frontmatter } from '../content/fr/home.mdx';
import { content } from '../content/fr/interface';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', name: content.brand, url: Astro.site?.href },
    { '@type': 'WebSite', name: content.brand, url: Astro.site?.href, inLanguage: 'fr-CH', description: frontmatter.description },
  ],
};
---
<Layout title={frontmatter.title} description={frontmatter.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="hero">
    <div class="hero-heading">
      <p class="eyebrow">{copy.home.eyebrow}</p>
      <h1>{copy.home.heading}</h1>
    </div>
    <div class="demo-frame">
      <Image src={dawn} alt="" width={700} format="webp" loading="eager" class="demo-background" />
      <section class="demo-card" aria-labelledby="demo-title">
        <p class="demo-label">{copy.demo.label}</p>
        <h2 id="demo-title">{copy.demo.title}</h2>
        <dl class="demo-metrics">
          <div><dt>{copy.demo.target}</dt><dd>{copy.demo.targetValue}</dd></div>
          <div><dt>{copy.demo.trajectory}</dt><dd>{copy.demo.trajectoryValue}</dd></div>
          <div class="demo-gap"><dt>{copy.demo.gap}</dt><dd>{copy.demo.gapValue}</dd></div>
        </dl>
        <p class="demo-question">{copy.demo.question}</p>
        <p class="preview-note">{copy.demo.note}</p>
        <a href="/demonstration" class="text-link" id="demo-details">{copy.demo.action}<span aria-hidden="true">↗</span></a>
      </section>
    </div>
    <div class="hero-copy">
      <div class="intro"><HomeContent /></div>
      <div class="hero-actions">
        <a href="/analyser-3p" class="primary-link">{copy.home.analyse}<span aria-hidden="true">→</span></a>
        <a href="/calculer-retraite" class="secondary-link">{copy.home.calculate}</a>
      </div>
      <p class="preview-note">{copy.home.note}</p>
    </div>
  </section>
  <section class="method-strip" aria-labelledby="method-title">
    <div><h2 id="method-title">{copy.home.methodTeaser}</h2><p>{copy.home.methodText}</p></div>
    <div class="account-actions"><a href="/methode" class="text-link">{copy.home.methodAction}<span aria-hidden="true">→</span></a><a href="/overview" class="text-link">{copy.choose}<span aria-hidden="true">→</span></a></div>
  </section>
</Layout>
