---
import Layout from '../layouts/Layout.astro';
import { Container, Section, SectionHeading, ButtonLink, TextLink } from '@coverview/ui';
import { marketing } from '../content/fr/marketing';
const copy = marketing.overview;
---
<Layout title={copy.seo.title} description={copy.seo.description}>
  <Section className="interior-hero"><Container><SectionHeading level={1} size="display" eyebrow={copy.eyebrow} title={copy.title} description={copy.description} align="center" /></Container></Section>
  <Container><div class="orientation-list">{copy.journeys.map((journey,index) => <section class="orientation-item">
    <div class="orientation-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</div>
    <div><SectionHeading level={2} size="medium" eyebrow={journey.eyebrow} title={journey.title} description={journey.description} /><TextLink href={journey.action.href}>{journey.action.label}</TextLink></div>
    <ul>{journey.questions.map(question => <li><span aria-hidden="true">✓</span>{question}</li>)}</ul>
  </section>)}</div></Container>
  <Section className="orientation-closing"><Container><SectionHeading title={copy.convergenceTitle} description={copy.convergenceDescription} align="center" /><div class="closing-actions"><ButtonLink href={copy.action.href}>{copy.action.label}</ButtonLink></div><p class="availability-note">{copy.availability}</p></Container></Section>
</Layout>
