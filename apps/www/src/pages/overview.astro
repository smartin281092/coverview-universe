---
import Layout from '../layouts/Layout.astro';
import { Container, Section, SectionHeading, ButtonLink } from '@coverview/ui';
import { marketing } from '../content/fr/marketing';
import BenefitArt from '../components/BenefitArt.astro';
const copy = marketing.overview;
---
<Layout title={copy.seo.title} description={copy.seo.description}>
  <Section className="interior-hero"><Container><SectionHeading level={1} size="display" eyebrow={copy.eyebrow} title={copy.title} description={copy.description} align="center" /></Container></Section>
  <Container><div class="orientation-list">{copy.journeys.map((journey, index) => <section class="orientation-item">
    <div class="orientation-art"><BenefitArt kind={index} /></div>
    <div><SectionHeading level={2} size="medium" eyebrow={journey.eyebrow} title={journey.title} description={journey.description} /><ul>{journey.questions.map(question => <li>{question}</li>)}</ul><ButtonLink href={journey.action.href}>{journey.action.label}</ButtonLink></div>
  </section>)}</div></Container>
  <Section tone="soft"><Container><SectionHeading title={copy.convergenceTitle} description={copy.convergenceDescription} align="center" /><div class="closing-actions"><ButtonLink href={copy.action.href}>{copy.action.label}</ButtonLink></div><p class="availability-note">{copy.availability}</p></Container></Section>
</Layout>
