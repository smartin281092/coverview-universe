---
import '../styles/global.css';
import { Container } from '@coverview/ui';
import logo from '../../../../assets/logo-coverview.svg?url';
import icon from '../../../../assets/icon-coverview.svg?url';
import { content } from '../content/fr/interface';
import { marketing as copy } from '../content/fr/marketing';
import { ConsentBanner } from '@coverview/ui/consent';
import { SiteHeader } from '../components/site/SiteHeader';
import { siteLinks } from '../components/site/site-links';
// ownHeader: the page shows the site header itself (home page, comparator).
interface Props { title: string; description: string; markdown?: string; structuredData?: Record<string, unknown>; minimal?: boolean; ownHeader?: boolean; }
const { title, description, markdown, structuredData, minimal = false, ownHeader = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.png', Astro.site);
const links = siteLinks(Astro.site?.origin ?? Astro.url.origin);
---
<!doctype html>
<html lang="fr-CH">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    {structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />}
    <link rel="icon" type="image/svg+xml" href={icon} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CoverView" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="fr_CH" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body class:list={{ 'landing-page': minimal }}>
    <a href="#main" class="skip-link">{content.skip}</a>
    {!ownHeader && <SiteHeader client:load pathname={Astro.url.pathname} {...links} />}
    <main id="main" tabindex="-1"><slot /></main>
    {!minimal && <footer class="site-footer">
      <Container>
        <div class="footer-main">
          <div class="footer-brand"><a href="/" aria-label={content.home}><img src={logo} alt={content.brand} width="444" height="73" class="logo" /></a><p>{copy.footer.statement}</p><small>{copy.footer.description}</small></div>
          <div><h2>{copy.footer.resources}</h2><ul><li><a href="/services">{copy.nav.services.label}</a></li><li><a href="/methode">{copy.nav.method.label}</a></li><li><a href="/articles">{copy.nav.resources.label}</a></li><li><a href={copy.footer.links.glossary.href}>{copy.footer.links.glossary.label}</a></li></ul></div>
          <div><h2>{copy.footer.company}</h2><ul><li><a href={copy.footer.links.vision.href}>{copy.footer.links.vision.label}</a></li><li><a href={copy.footer.links.questions.href}>{copy.footer.links.questions.label}</a></li><li><a href={copy.footer.links.sources.href}>{copy.footer.links.sources.label}</a></li><li><a href={copy.nav.all.href}>{copy.nav.all.label}</a></li></ul></div>
          <div><h2>{copy.footer.account}</h2><ul><li><a href="/account">{copy.nav.account.label}</a></li><li><a href={copy.footer.links.overview.href}>{copy.footer.links.overview.label}</a></li><li><a href={copy.footer.links.contact.href}>{copy.footer.links.contact.label}</a></li></ul></div>
        </div>
        <div class="footer-bottom"><p>© {new Date().getFullYear()} {copy.footer.copyright}</p><p>{copy.footer.availability}</p>{import.meta.env.PUBLIC_POSTHOG_KEY && <button type="button" class="footer-consent" data-consent-open>{content.consent.settings}</button>}</div>
      </Container>
    </footer>}
    {/* MKT-09: PostHog only after an explicit yes; the banner loads when the page is idle, at most 2 s later. */}
    <ConsentBanner
      client:idle={{ timeout: 2000 }}
      config={{ key: import.meta.env.PUBLIC_POSTHOG_KEY, host: import.meta.env.PUBLIC_POSTHOG_HOST, replay: false, singlePage: false }}
      texts={{ title: content.consent.title, message: content.consent.message, accept: content.consent.accept, refuse: content.consent.refuse }}
    />
    <script>
      import { openConsentSettings } from '@coverview/ui/analytics';
      for (const button of document.querySelectorAll('[data-consent-open]')) button.addEventListener('click', openConsentSettings);
    </script>
  </body>
</html>
