{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:env": "tsx src/platform/config.check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/platform/db/maintenance.ts migrate",
    "db:seed": "tsx src/platform/db/maintenance.ts seed",
    "db:reset": "tsx src/platform/db/maintenance.ts reset"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@cantoo/pdf-lib": "^2.9.2",
    "@coverview/contracts": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@workos-inc/node": "10.13.0",
    "bullmq": "^6.3.4",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "fastify-type-provider-zod": "7.0.0",
    "file-type": "^22.0.2",
    "pg": "8.23.0",
    "redis": "6.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13"
  }
}
