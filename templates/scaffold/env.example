# .env.example — ENV-02 : exhaustif, committé, AUCUNE valeur réelle (G-04).
# Le schéma de validation au démarrage (BACK-07) est la référence ; ce fichier le suit.
# Toute nouvelle variable = mise à jour ici + mention au compte rendu.

# ── Environnement ──────────────────────────────────────────────────────────
# OBLIGATOIRE. `/preview` refuse de démarrer si ce n'est ni local ni development
# (ENV-08) : c'est ce garde qui rend acceptable l'affichage en clair des
# identifiants de personas. Ne jamais le définir à « local » ailleurs qu'en local.
APP_ENV=local
NODE_ENV=development
LOG_LEVEL=debug

# ── Bases ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379

# ── Authentification (Better Auth) ─────────────────────────────────────────
# Générer : openssl rand -base64 32 — jamais committé, jamais loggé (SEC-03).
BETTER_AUTH_SECRET=remplacer-par-un-secret-genere
BETTER_AUTH_URL=http://localhost:4000
# OAuth — laisser vide si non activé au bootstrap (bloc 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Applications ───────────────────────────────────────────────────────────
API_PORT=4000
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
WWW_URL=http://localhost:3002
# CORS strict (SEC-04) : origines autorisées, séparées par des virgules
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Stockage objet (STOR-08) ───────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=app-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ── Email (MAIL-02) ────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@exemple.test

# ── Seeds (ENV-07) ─────────────────────────────────────────────────────────
# Mot de passe commun des personas. Ce n'est PAS un secret (SEC-03 ne s'applique
# pas) parce qu'ENV-08 rend l'existence de ces comptes impossible hors local.
SEED_PASSWORD=preview-local

# ── Paiements (BILL-10) — uniquement si Stripe est activé ──────────────────
# Clés TEST en local, strictement séparées des clés live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── LLM (LLM-01) — uniquement si des fonctionnalités IA sont activées ──────
LLM_API_KEY=
LLM_MODEL=
