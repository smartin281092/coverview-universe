{
  "permissions": {
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push -f*)",
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(pnpm db:reset*)",
      "Bash(pnpm db:migrate*)",
      "Bash(docker compose down*)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-bash.mjs"
          }
        ]
      }
    ]
  }
}
