{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["APP_ENV", "NODE_ENV"],
  "globalDependencies": [".env", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".astro/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "AUTH_*",
        "WORKOS_*",
        "DATABASE_URL",
        "REDIS_URL",
        "CORS_ORIGINS",
        "API_*",
        "FIXTURE_MODE",
        "EXTERNAL_ADAPTER_MODE",
        "LOG_LEVEL",
        "MINIO_ENDPOINT",
        "MAILPIT_URL",
        "DEPENDENCY_TIMEOUT_MS"
      ]
    },
    "@coverview/contracts#build": {
      "outputs": []
    },
    "@coverview/api-client#build": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
